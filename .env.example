# ============================================================================
# SmartCard BUS - Variáveis de Ambiente (MySQL + Supabase + Vercel + Mercado Pago)
# ============================================================================

# 1. Configuração do Banco de Dados MySQL (XAMPP / Servidor Dedicado)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smartcard_bus

# 2. Porta do Servidor Backend API e Segredo JWT
PORT=3001
JWT_SECRET=smartcard_bus_bank_grade_hmac_secret_2026
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# 3. Integração Oficial Mercado Pago (Pix, Cartão & Webhook)
MP_ACCESS_TOKEN=APP_USR-SEU-TOKEN-MERCADO-PAGO
EXPO_PUBLIC_MP_ACCESS_TOKEN=APP_USR-SEU-TOKEN-MERCADO-PAGO

# 4. Integração Supabase (PostgreSQL em Nuvem - opcional / produção Vercel)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_supabase
