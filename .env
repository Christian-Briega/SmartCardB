# ============================================================================
# SmartCard BUS - Credenciais de Envio Real de SMS e WhatsApp (.env)
# Edite qualquer uma das opções abaixo (não precisa reiniciar o servidor)
# ============================================================================

# OPÇÃO 1 (Mais rápida e gratuita p/ seu WhatsApp): CallMeBot API
# 1. No WhatsApp do seu celular, envie a mensagem: "I allow callmebot to send me messages"
#    para o número: +34 644 51 95 23
# 2. Cole abaixo a apikey de 6 dígitos que o bot responder no seu WhatsApp:
CALLMEBOT_API_KEY=5960619

# OPÇÃO 2 (Envio de SMS e WhatsApp para qualquer número): Twilio API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=+14155238886

# OPÇÃO 3 (WhatsApp para qualquer número): Z-API ou Evolution API Webhook
ZAPI_INSTANCE_URL=
ZAPI_CLIENT_TOKEN=

# OPÇÃO 4 (Meta WhatsApp Cloud API Oficial):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OPÇÃO 5 (Gateway SMS Textbelt):
TEXTBELT_API_KEY=

